{
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "id": "jointMotor",
    "kind": "node",
    "name": "Joint motor",
    "description": "A DC motor and gearbox driving one joint of a mechanism. Its current comes from its supply and the joint's back-EMF (the joint drive bundle); its torque at the joint is the gear ratio times the torque constant times the current, which the mechanism reads; its winding heats with the current and cools to ambient. The gearbox is ideal (no losses or backlash) and the current is not limited.",
    "domains": ["electrical", "mechanical", "thermal"],
    "shape": "cylinder",
    "color": "#397b86",
    "states": [
        { "symbol": "current", "label": "Current", "initialValue": 0, "unit": "A" },
        { "symbol": "torque", "label": "Torque at the joint", "initialValue": 0, "unit": "N·m" },
        { "symbol": "windingTemperature", "label": "Winding temperature", "initialValue": 293.15, "unit": "K" }
    ],
    "sharedParameters": [
        { "key": "resistance", "name": "Winding resistance", "symbol": "resistance", "value": 1.2, "unit": "Ω", "scope": "instance" },
        { "key": "torqueConstant", "name": "Torque constant", "symbol": "torqueConstant", "value": 0.05, "unit": "N·m/A", "scope": "instance" },
        { "key": "gearRatio", "name": "Gear ratio", "symbol": "gearRatio", "value": 50, "unit": "", "scope": "instance" }
    ],
    "sourceTerms": [
        {
            "state": "torque",
            "setsValue": true,
            "expression": "\\mathrm{gearRatio} \\cdot \\mathrm{torqueConstant} \\cdot \\mathrm{current}",
            "parameters": [
                { "name": "Gear ratio", "symbol": "gearRatio", "shared": "gearRatio" },
                { "name": "Torque constant", "symbol": "torqueConstant", "shared": "torqueConstant" }
            ]
        },
        {
            "state": "windingTemperature",
            "expression": "\\frac{\\mathrm{resistance} \\cdot \\mathrm{current}^{2} - \\frac{\\mathrm{windingTemperature} - \\mathrm{ambientTemperature}}{\\mathrm{thermalResistance}}}{\\mathrm{thermalCapacitance}}",
            "parameters": [
                { "name": "Winding resistance", "symbol": "resistance", "shared": "resistance" },
                { "name": "Thermal resistance to ambient", "symbol": "thermalResistance", "value": 8, "unit": "K/W", "mode": "constant" },
                { "name": "Winding thermal capacitance", "symbol": "thermalCapacitance", "value": 20, "unit": "J/K", "mode": "constant" },
                { "name": "Ambient temperature", "symbol": "ambientTemperature", "value": 293.15, "unit": "K", "mode": "constant" }
            ]
        }
    ]
}
