<!-- Boxes on boxes and spheres on cylinders, for tests/engine/contact.test.mjs: a brick and a cube dropped onto a table
     fixed to the world (box against box: a face on a face, the cube landing on a corner first), a ball dropped onto a
     log lying on its side (a sphere against a cylinder's side) and a pebble dropped near the rim of a post standing up
     (its rim first, then off it). MuJoCo's solver runs until it has converged, as in collision.xml. -->
<mujoco model="Shapes">
  <compiler angle="radian"/>
  <option timestep="0.001" integrator="implicitfast" tolerance="1e-15" iterations="1000"/>
  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.05"/>
    <body name="Table" pos="0 0 0.05">
      <inertial pos="0 0 0" mass="5" diaginertia="0.05 0.05 0.05"/>
      <geom name="table" type="box" size="0.15 0.15 0.05" mass="0"/>
    </body>
    <body name="Brick" pos="0.03 0.01 0.13" quat="0.9995 0.02 0.015 0.01">
      <freejoint/>
      <geom name="brick" type="box" size="0.04 0.03 0.02" mass="0.2"/>
    </body>
    <body name="Cube" pos="-0.07 0.06 0.17" quat="0.9 0.2 0.3 0.25">
      <freejoint/>
      <geom name="cube" type="box" size="0.025 0.025 0.025" mass="0.1"/>
    </body>
    <body name="Log" pos="0.4 0 0.04" quat="0.70710678 0.70710678 0 0">
      <inertial pos="0 0 0" mass="2" diaginertia="0.01 0.01 0.01"/>
      <geom name="log" type="cylinder" size="0.04 0.1" mass="0"/>
    </body>
    <body name="Ball" pos="0.415 0.02 0.14">
      <freejoint/>
      <geom name="ball" type="sphere" size="0.03" mass="0.1"/>
    </body>
    <body name="Post" pos="-0.4 0 0.05">
      <inertial pos="0 0 0" mass="2" diaginertia="0.01 0.01 0.01"/>
      <geom name="post" type="cylinder" size="0.03 0.05" mass="0"/>
    </body>
    <body name="Pebble" pos="-0.4 0.033 0.13">
      <freejoint/>
      <geom name="pebble" type="sphere" size="0.012" mass="0.02"/>
    </body>
  </worldbody>
</mujoco>
