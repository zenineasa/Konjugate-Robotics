<!-- A two-finger gripper on a lift, over a box on the floor: the fingers close on the box (fast) while the lift rises
     (slowly), so the box comes off the floor held by friction alone. The contact tests give the fingers spherical tips
     and the box its shape to touch with (tests/engine/contact.test.mjs). -->
<mujoco model="Gripper">
  <compiler angle="radian"/>
  <worldbody>
    <body name="Carriage" pos="0 0 0.03">
      <joint name="Lift" type="slide" axis="0 0 1"/>
      <inertial pos="0 0 0.05" mass="0.5" diaginertia="0.002 0.002 0.002"/>
      <body name="Left finger" pos="0 0.07 0">
        <joint name="Left" type="slide" axis="0 -1 0"/>
        <inertial pos="0 0 0" mass="0.05" diaginertia="0.00001 0.00001 0.00001"/>
      </body>
      <body name="Right finger" pos="0 -0.07 0">
        <joint name="Right" type="slide" axis="0 1 0"/>
        <inertial pos="0 0 0" mass="0.05" diaginertia="0.00001 0.00001 0.00001"/>
      </body>
    </body>
    <body name="Part" pos="0 0 0.03">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="0.00003 0.00003 0.00003"/>
    </body>
  </worldbody>
  <actuator>
    <position name="Lift servo" joint="Lift" kp="300" kv="150" ctrlrange="-0.1 0.2" forcerange="-20 20"/>
    <position name="Left servo" joint="Left" kp="60" kv="2" forcerange="-5 5"/>
    <position name="Right servo" joint="Right" kp="60" kv="2" forcerange="-5 5"/>
  </actuator>
</mujoco>
