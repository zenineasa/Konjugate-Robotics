<mujoco model="Test arm">
  <compiler angle="degree" meshdir="meshes"/>
  <default>
    <joint damping="0.05" armature="0.001"/>
    <position kp="20" forcerange="-50 50"/>
    <default class="visual">
      <geom group="2" contype="0" conaffinity="0" mass="0"/>
    </default>
    <default class="link">
      <geom group="3" contype="0" conaffinity="0"/>
    </default>
  </default>
  <asset>
    <mesh name="turret" file="turret.stl" scale="0.001 0.001 0.001"/>
    <material name="blue" rgba="0.2 0.4 0.8 1"/>
  </asset>
  <worldbody>
    <body name="Base" pos="0 0 0.05">
      <inertial pos="0 0 0" mass="2" diaginertia="0.01 0.01 0.015"/>
      <geom class="visual" type="cylinder" size="0.06 0.05" material="blue"/>
      <body name="Turret" pos="0 0 0.06" childclass="link">
        <joint name="Waist" axis="0 0 1" range="-170 170"/>
        <inertial pos="0.01 0 0.02" mass="0.5" fullinertia="0.002 0.003 0.0025 0.0002 -0.0001 0.00015"/>
        <geom class="visual" type="mesh" mesh="turret" rgba="0.8 0.5 0.2 1"/>
        <frame pos="0 0 0.04" euler="0 0 90">
          <body name="Upper arm">
            <joint name="Shoulder" axis="0 1 0" range="-90 90" ref="10"/>
            <geom type="capsule" fromto="0 0 0 0.2 0 0" size="0.02" density="1200"/>
            <geom type="box" pos="0.1 0 0.03" size="0.03 0.02 0.01" mass="0.05"/>
            <body name="Bracket" pos="0.2 0 0">
              <geom class="visual" type="box" size="0.01 0.03 0.03"/>
              <body name="Forearm" pos="0.01 0 0">
                <joint name="Elbow" axis="0 1 0"/>
                <inertial pos="0.08 0 0" quat="0.7071068 0 0.7071068 0" mass="0.3" diaginertia="0.0008 0.0008 0.0001"/>
                <geom class="visual" type="cylinder" fromto="0 0 0 0.16 0 0" size="0.015"/>
                <body name="Tip" pos="0.16 0 0">
                  <joint name="Extend" type="slide" axis="1 0 0" range="-0.02 0.04" damping="2"/>
                  <inertial pos="0 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
                  <geom class="visual" type="box" size="0.02 0.01 0.01"/>
                </body>
              </body>
            </body>
          </body>
        </frame>
      </body>
    </body>
    <body name="Mount" pos="0.4 0 0.3">
      <inertial pos="0 0 0" mass="0.2" diaginertia="0.0001 0.0001 0.0001"/>
      <body name="Bob" pos="0 0 -0.02" euler="20 0 0">
        <joint name="Swing" type="ball" range="0 60"/>
        <inertial pos="0 0 -0.05" mass="0.2" diaginertia="0.0002 0.0003 0.0001"/>
        <geom class="visual" type="sphere" pos="0 0 -0.05" size="0.02"/>
      </body>
    </body>
  </worldbody>
  <tendon>
    <fixed name="Coupling">
      <joint joint="Shoulder" coef="1"/>
      <joint joint="Elbow" coef="-1"/>
    </fixed>
  </tendon>
  <equality>
    <joint name="Lock" joint1="Extend" active="false"/>
  </equality>
  <actuator>
    <position name="Waist servo" joint="Waist" kp="30" dampratio="1" forcerange="-20 20"/>
    <position name="Shoulder servo" joint="Shoulder" kp="40" kv="0.5" gear="2" forcerange="-5 5"/>
    <motor name="Elbow motor" joint="Elbow" ctrlrange="-1 1"/>
    <damper name="Extend brake" joint="Extend" kv="1" ctrlrange="0 1"/>
    <position name="Extend servo" joint="Extend" kp="400" forcerange="-20 20" ctrlrange="0.005 0.03"/>
  </actuator>
</mujoco>
