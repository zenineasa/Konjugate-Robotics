{
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "id": "servoSupply",
    "kind": "bundle",
    "name": "Servo supply",
    "description": "Wires a smart servo's current (a mechanism's servo joint reporting it) to the battery that supplies it and the winding it heats. The servo is on the supply directly: the battery's charge falls by the current over its capacity, and the winding heats by its resistance times the current squared. The default resistance is the 7.4 V Feetech STS3215's, from its listed stall current at 6 V (6 V over 2 A).",
    "domains": ["electrical", "thermal"],
    "color": "#d08a5a",
    "endpoints": [
        { "id": "battery", "label": "Battery" },
        { "id": "winding", "label": "Servo winding" },
        { "id": "joint", "label": "Servo joint", "ports": ["current"] }
    ],
    "sharedParameters": [
        { "key": "resistance", "name": "Winding resistance (6 V over the 2 A stall current)", "symbol": "resistance", "value": 3, "unit": "Ω", "scope": "instance" },
        { "key": "thermalCapacitance", "name": "Winding thermal capacitance (assumed)", "symbol": "thermalCapacitance", "value": 10, "unit": "J/K", "scope": "instance" },
        { "key": "capacity", "name": "Battery capacity", "symbol": "capacity", "value": 7200, "unit": "A·s", "scope": "instance" }
    ],
    "edges": [
        {
            "name": "Heating",
            "from": "joint",
            "to": "winding",
            "ports": { "source": "current", "target": "windingTemperature" },
            "output": { "role": "target", "state": "windingTemperature" },
            "latex": "\\frac{\\mathrm{resistance} \\cdot \\mathrm{sourceCurrent}^{2}}{\\mathrm{thermalCapacitance}}",
            "parameters": [
                { "name": "Winding resistance", "symbol": "resistance", "shared": "resistance" },
                { "name": "Winding thermal capacitance", "symbol": "thermalCapacitance", "shared": "thermalCapacitance" }
            ]
        },
        {
            "name": "Drain",
            "from": "joint",
            "to": "battery",
            "ports": { "source": "current", "target": "stateOfCharge" },
            "output": { "role": "target", "state": "stateOfCharge" },
            "latex": "-\\frac{100 \\cdot \\mathrm{sourceCurrent}}{\\mathrm{capacity}}",
            "parameters": [
                { "name": "Battery capacity", "symbol": "capacity", "shared": "capacity" }
            ]
        }
    ]
}
