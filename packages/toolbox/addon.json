{
    "addonId": "konjugate.robotics.toolbox",
    "name": "Robotics Toolbox",
    "version": "0.0.0",
    "apiVersion": 1,
    "kind": "launcher",
    "entry": "index.html",
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "permissions": [
        "data.import",
        "model.open",
        "project.data"
    ],
    "requires": [
        "projectSession",
        "keepSession",
        "algebraicRelationships"
    ],
    "contributes": {
        "toolstrip": [
            {
                "commandId": "openRoboticsToolbox",
                "label": "Robotics",
                "tooltip": "Open the Robotics window: draw a robot and build it into the canvas",
                "symbol": "⚙",
                "when": "always",
                "contexts": []
            }
        ],
        "importers": [
            {
                "importerId": "drawing",
                "name": "Robot drawing",
                "entry": "importers/drawing.mjs",
                "files": [
                    {
                        "role": "drawing",
                        "label": "Drawing",
                        "accept": ["json"],
                        "description": "A robot drawing as JSON (format konjugate.robotics.drawing, version 1): written by a script, or kept from another project. Opening one replaces the drawing in the window, and can be undone."
                    }
                ]
            }
        ]
    }
}
