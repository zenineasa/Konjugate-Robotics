{
    "addonId": "konjugate.robotics.toolbox",
    "name": "Robotics Toolbox",
    "version": "0.0.0",
    "apiVersion": 1,
    "kind": "launcher",
    "entry": "index.html",
    "copyright": "Copyright © 2026 Zenin Easa Panthakkalakath",
    "permissions": [
        "data.import",
        "files.store",
        "model.open",
        "network.fetch",
        "project.data",
        "scenario.run"
    ],
    "requires": [
        "projectSession",
        "keepSession",
        "binaryInputs",
        "multipleBinaryInputs",
        "storedFiles",
        "nodeProviderInputs",
        "scenarioForkTime",
        "suppliedPerParameter"
    ],
    "contributes": {
        "toolstrip": [
            {
                "commandId": "openRoboticsToolbox",
                "label": "Robotics",
                "tooltip": "Open the Robotics Toolbox",
                "symbol": "⚙",
                "when": "always",
                "contexts": []
            }
        ],
        "importers": [
            {
                "importerId": "robot",
                "name": "Robot",
                "entry": "importers/robot.mjs",
                "files": [
                    {
                        "role": "model",
                        "binary": true,
                        "multiple": true,
                        "label": "Robot model",
                        "accept": [
                            "xml",
                            "stl",
                            "obj",
                            "msh",
                            "png"
                        ],
                        "description": "A robot's MuJoCo model (its MJCF and the meshes and textures it reads), as fetched from MuJoCo Menagerie and kept on this computer: each file named for its path in the model's folder, with / written as ^."
                    }
                ]
            }
        ],
        "scenarios": [
            {
                "scenarioId": "heavierPayload",
                "name": "Heavier payload",
                "description": "From a time in the move, the gripper carries a heavier payload. Watch which servos reach their limit, how hot their windings get and how much charge the move takes.",
                "forkAt": 2.5,
                "runTime": 9,
                "effects": [
                    "The payload's mass changes to the one given, from the time given to the end of the run."
                ],
                "interventions": [
                    {
                        "parameter": "payloadMass",
                        "target": "supplied",
                        "samples": true
                    }
                ]
            },
            {
                "scenarioId": "weakerServo",
                "name": "Weaker servo",
                "description": "From a time in the move, a servo gives less torque than its datasheet says, as a worn or a smaller one would. Watch whether the move is still made, and what the others do about it.",
                "forkAt": 0,
                "runTime": 9,
                "effects": [
                    "The chosen servo's torque limit changes to the one given, from the time given to the end of the run."
                ],
                "interventions": [
                    {
                        "parameter": "servoTorqueLimit",
                        "target": "supplied",
                        "samples": true
                    }
                ]
            }
        ]
    },
    "network": {
        "hosts": [
            "api.github.com",
            "raw.githubusercontent.com"
        ]
    }
}
